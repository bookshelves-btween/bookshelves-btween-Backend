aws_region      = "ap-northeast-2"
project_name    = "bookshelf"
environment     = "dev"
instance_type   = "t3.medium"
root_volume_size = 30

# Recommended: keep both values empty and connect through AWS Systems Manager.
# To enable SSH, set BOTH values. admin_cidr must be your current public IP /32.
admin_cidr    = ""
ssh_public_key = ""
