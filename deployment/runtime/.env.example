# Container image built by CI. A sha256 digest is required by deploy.sh.
APP_IMAGE=ghcr.io/bookshelves-btween/bookshelves-btween-backend@sha256:CHANGE_TO_IMAGE_DIGEST

# Host paths to a certificate issued for the public API domain. Never commit the private key.
TLS_CERT_PATH=/etc/letsencrypt/live/api.example.com/fullchain.pem
TLS_PRIVATE_KEY_PATH=/etc/letsencrypt/live/api.example.com/privkey.pem

MYSQL_DATABASE=bookshelf
MYSQL_HOST=CHANGE_TO_TERRAFORM_DATABASE_ENDPOINT
MYSQL_PORT=3306
MYSQL_USER=bookshelf_admin
MYSQL_PASSWORD=CHANGE_TO_TERRAFORM_DATABASE_PASSWORD

# Generated by scripts/prepare-rds-truststore.sh from the official AWS RDS CA bundle.
RDS_CA_BUNDLE_PATH=/opt/bookshelf/certs/global-bundle.pem
RDS_TRUSTSTORE_PATH=/opt/bookshelf/certs/rds-truststore.jks
RDS_TRUSTSTORE_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD

REDIS_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
JWT_SECRET=CHANGE_TO_AT_LEAST_64_RANDOM_CHARACTERS
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600

# Comma-separated origins expected by the Spring Boot CORS configuration.
CORS_ALLOWED_ORIGINS=https://app.example.com

# External API / OAuth credentials
# Kakao Developers app ID (숫자). 소셜 로그인 토큰이 우리 앱에 발급된 것인지 검증하는 데 쓰인다.
KAKAO_APP_ID=CHANGE_TO_KAKAO_APP_ID
KAKAO_REST_API_KEY=CHANGE_TO_KAKAO_REST_API_KEY
GEMINI_API_KEY=CHANGE_TO_GEMINI_API_KEY
DATA4LIBRARY_AUTH_KEY=CHANGE_TO_DATA4LIBRARY_AUTH_KEY
GOOGLE_CLIENT_ID=CHANGE_TO_GOOGLE_CLIENT_ID
APPLE_CLIENT_ID=CHANGE_TO_APPLE_CLIENT_ID

# 테스트용 토큰 발급 API(/api/v1/auth/fake-signup) 비밀값.
# 비워두면 해당 API는 모든 요청을 거부한다. 테스트가 끝나면 값을 지운다.
# 앱 공개 전에는 이 항목과 API를 함께 제거한다.
FAKE_SIGNUP_SECRET=

# Firebase Admin SDK (FCM). Keep the service-account JSON outside the repository.
FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=CHANGE_TO_FIREBASE_PROJECT_ID
FIREBASE_CREDENTIALS_PATH=/opt/bookshelf/secrets/firebase-service-account.json
