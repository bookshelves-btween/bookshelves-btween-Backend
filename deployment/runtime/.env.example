# Container image built by CI. Replace this after the Spring Boot repository is ready.
APP_IMAGE=ghcr.io/your-github-org/bookshelf-server:latest

MYSQL_DATABASE=bookshelf
MYSQL_USER=bookshelf_app
MYSQL_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_TO_A_DIFFERENT_LONG_RANDOM_PASSWORD

REDIS_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
JWT_SECRET=CHANGE_TO_AT_LEAST_64_RANDOM_CHARACTERS

# Comma-separated origins expected by the Spring Boot CORS configuration.
CORS_ALLOWED_ORIGINS=http://localhost:3000
