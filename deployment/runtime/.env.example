# Container image built by CI. A sha256 digest is required by deploy.sh.
APP_IMAGE=ghcr.io/bookshelves-btween/bookshelves-btween-backend@sha256:CHANGE_TO_IMAGE_DIGEST

# Host paths to a certificate issued for the public API domain. Never commit the private key.
TLS_CERT_PATH=/etc/letsencrypt/live/api.example.com/fullchain.pem
TLS_PRIVATE_KEY_PATH=/etc/letsencrypt/live/api.example.com/privkey.pem

MYSQL_DATABASE=bookshelf
MYSQL_HOST=CHANGE_TO_TERRAFORM_DATABASE_ENDPOINT
MYSQL_PORT=3306
MYSQL_USER=bookshelf_admin
MYSQL_PASSWORD=CHANGE_TO_TERRAFORM_DATABASE_PASSWORD

REDIS_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
JWT_SECRET=CHANGE_TO_AT_LEAST_64_RANDOM_CHARACTERS

# Comma-separated origins expected by the Spring Boot CORS configuration.
CORS_ALLOWED_ORIGINS=https://app.example.com
